# =====================================================================
# AIGENT-WORKFLOW STUDIO —— 环境变量样例（复制为 .env 后按需填写）
# 任何真实密钥不得提交进 git（.gitignore 已覆盖 .env / .env.local）
# =====================================================================

# ---------- 大模型驱动（真实算子 llm_generic / ui_generation 需要） ----------
# LLM API Key（必填才能启用 LLM 真实推理；留空则相关节点走内置模板并标 degraded）
LLM_API_KEY=
# API Base（会被 SSRF 校验：默认拒绝解析到内网/保留地址；生产还要求白名单）
LLM_API_BASE=https://api.openai.com/v1
# 模型名
LLM_MODEL=gpt-4o-mini
# LLM 并发信号量（讯飞等平台限流时调低）
LLM_MAX_CONCURRENCY=2
# LLM 单次调用超时秒数（慢速长文本模型可调大）
LLM_TIMEOUT_S=60

# ---------- 安全（生产必读） ----------
# 管理令牌：设置后所有写接口 / /publish/* / /settings/* /metrics 必须携带 X-Admin-Token；
# WS 用 ?token= 或 Sec-WebSocket-Protocol；live-app/export-zip 走短期签名 URL。
# AIGENT_ENV=production 时本变量必填，缺失则启动失败。
AIGENT_ADMIN_TOKEN=
# api_base 主机白名单（逗号分隔）：生产必填；非空时跳过 DNS 解析校验（信任白名单）
LLM_API_BASE_ALLOWLIST=
# 显式放行内网/保留地址的 api_base（本地 llama.cpp 等场景；生产勿开）
AIGENT_ALLOW_PRIVATE_LLM=
# 只读 GET 是否免令牌（1=放行）；默认不放行
AIGENT_PUBLIC_READ=
# 运行环境标识：production 时启用强制配置校验（见上）
AIGENT_ENV=

# ---------- 网络 ----------
# CORS 与 WS Origin 白名单（逗号分隔）；compose 部署含入口源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# 反代场景信任的 X-Forwarded-For 来源（uvicorn --forwarded-allow-ips，精确 IP）
AIGENT_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ---------- 持久化 ----------
# SQLite 路径（compose 内为 /app/data/aigent_checkpoints.db，挂命名卷）
AIGENT_DB_PATH=aigent_checkpoints.db
# 拓扑持久化开关（1=开）
AIGENT_PERSIST_TOPOLOGY=1
# 断点库上限（超出按时间倒序剪枝）
CHECKPOINT_MAX=2000

# ---------- 限流与容量上限（T13） ----------
# 写接口 60/min/IP；严格面（/settings、/ast/validate、export-zip）10/min/IP
AIGENT_RATE_LIMIT_PER_MIN=60
AIGENT_STRICT_RATE_LIMIT_PER_MIN=10
# 节点 / 连线总数上限（超限 413）
AIGENT_MAX_NODES=200
AIGENT_MAX_EDGES=500
